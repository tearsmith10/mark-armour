# ── Existing app (React/Vite) ────────────────────────────────────────────────
# OLLAMA — same-origin proxy is used by default (see vite.config.js),
# so you normally don't need this. Only needed if you call Ollama directly.
# VITE_OLLAMA_URL=http://localhost:11434
# Default model — must be pulled already, e.g. `ollama pull llama3.1`
VITE_OLLAMA_MODEL=llama3.1
# Optional — enables real Google Sign-In (see README "Auth notes")
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Self-coding agent (src/agent) ───────────────────────────────────────────
# Copy to .env and adjust. NEVER commit .env (it is gitignored; .env.example
# is the committed template). The agent loads .env but deliberately does NOT
# load .env.local (that file holds deploy secrets such as Vercel OIDC).

# Provider: ollama (default) | openai | anthropic | mock
#   ollama    — local model via OLLAMA_BASE_URL, no key required
#   openai    — OpenAI or any OpenAI-compatible gateway (set OPENAI_BASE_URL)
#   anthropic — Anthropic API
#   mock      — deterministic offline model for tests / --dry-run demos
AGENT_LLM_PROVIDER=ollama
# Model name (defaults per provider, e.g. llama3.1 / gpt-4o-mini / claude-sonnet)
# AGENT_LLM_MODEL=llama3.1

# Endpoints (only needed if not using provider defaults)
# OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# API keys — set via environment, never hard-code in source.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Run limits (self-correction safety rails)
# AGENT_MAX_STEPS=24              # total tool actions per run
# AGENT_MAX_ACTIONS_PER_STEP=6    # actions allowed per model turn
# AGENT_MAX_REPAIRS=3             # verify→fix attempts before giving up

# Validation commands — overrides auto-detection (package.json test/lint/
# typecheck/check/build, falling back to `node --check` over the sources).
# Multiple commands are joined with &&  (shell syntax, so "||" also works).
# AGENT_VERIFY_COMMANDS=npm run typecheck && npm test && npm run build
# AGENT_NO_VERIFY=1               # skip validation entirely (not recommended)

# Context budget: max characters of gathered context handed to the model.
# AGENT_CONTEXT_BUDGET=14000
# AGENT_COMMAND_TIMEOUT_MS=180000

# Safety: allow destructive commands (rm -rf, git reset --hard, drop …).
# Default is deny. Only enable for throwaway workspaces.
# AGENT_ALLOW_UNSAFE=1

# Logging: silent | error | warn | info | debug. File path is relative to the
# workspace; use "none" to disable file logging (stdout/stderr still used).
# AGENT_LOG_LEVEL=info
# AGENT_LOG_FILE=.agent/logs/agent.log

# Scripted replies for the mock provider — each entry is one model turn
# (JSON action). Use to reproduce exact agent behaviour in tests.
# AGENT_MOCK_SCRIPT={"tool":"read_file","args":{"path":"package.json"}} {"done":true,"summary":"fin"}
