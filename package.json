{
  "name": "trello-todo-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Trello-style todo app with local Ollama AI + localStorage persistence",
  "bin": {
    "office-agent": "./src/main.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "agent": "node src/main.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "5.9",
    "vite": "^5.4.11"
  }
}
